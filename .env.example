# Copy to .env. Everything here points at the local Docker stack (`pnpm up`);
# nothing in this file is a secret, and nothing real ever runs against it.

# ---------------------------------------------------------------------------
# Database — three roles, three URLs, deliberately not interchangeable (§5.1)
# ---------------------------------------------------------------------------
# Applies migrations and runs seeds. Holds DDL rights that neither application
# role has (§5.9).
MIGRATION_DATABASE_URL=postgres://migrator:migrator@localhost:5433/blood_connect
# The web app and the worker: hospital + reference, and nothing in bot.
DATABASE_URL=postgres://app_web:app_web@localhost:5433/blood_connect
# The bot: its own schema, reference read-only, and only the contract columns of
# hospital.donor_demand.
BOT_DATABASE_URL=postgres://app_bot:app_bot@localhost:5433/blood_connect
# The suite truncates every table between tests, so it gets its own database and
# the harness refuses any URL that is not named for testing.
TEST_DATABASE_URL=postgres://migrator:migrator@localhost:5433/blood_connect_test

# ---------------------------------------------------------------------------
# Chat channel (§2.11, §10)
# ---------------------------------------------------------------------------
# From @BotFather. Long-polling, so no public URL and no webhook is needed for
# the demonstration. Nothing above the channel adapter knows the platform.
TELEGRAM_BOT_TOKEN=replace-me
CHANNEL=telegram

# ---------------------------------------------------------------------------
# Email — Mailpit, the local catcher. Inbox at http://localhost:8025
# ---------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM="Blood Connect <no-reply@blood-connect.local>"

# ---------------------------------------------------------------------------
# Object storage — MinIO. Private bucket; objects are only ever served through
# an authenticated route (§3, §4).
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=blood-connect
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
# One configured application timezone, used in exactly one function (§5.2).
APP_TIMEZONE=Asia/Kolkata
# Hosting region, answered before there was data to migrate (open question #5).
DEPLOY_REGION=ap-south-1
# Session cookie signing. Generate a real one per environment.
SESSION_SECRET=development-only-change-me

# Reverse geocoding is a stubbed adapter returning null for the demonstration.
# The type-ahead path is the spec's own fallback (§10) and is what gets shown.
GEOCODER=stub
