{
  "name": "@blood-connect/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./bot": {
      "types": "./dist/src/schema-bot/index.d.ts",
      "default": "./dist/src/schema-bot/index.js"
    }
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "generate": "drizzle-kit generate",
    "migrate": "tsc -b && node dist/src/migrate.js",
    "seed": "tsc -b && node dist/src/seed.js",
    "push": "tsc -b && node dist/src/push-guard.js && drizzle-kit push",
    "generate:bot": "drizzle-kit generate --config drizzle-bot.config.ts",
    "migrate:bot": "tsc -b && node dist/src/migrate-bot.js"
  },
  "dependencies": {
    "@blood-connect/config": "workspace:*",
    "@blood-connect/contract": "workspace:*",
    "@blood-connect/domain": "workspace:*",
    "@blood-connect/ids": "workspace:*",
    "@node-rs/argon2": "^2.2.0",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  }
}
