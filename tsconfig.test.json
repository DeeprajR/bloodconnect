{
  "$comment": "Test files are excluded from the emitted build but must still typecheck — a test that does not compile is a test that is not run.",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"]
  },
  "include": [
    "packages/**/*.test.ts",
    "db/**/*.test.ts",
    "vitest.config.ts",
    "db/drizzle.config.ts",
    "db/vitest.setup.ts"
  ]
}
